# backend/app/main.py
from fastapi import FastAPI, Request, status
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from sqlalchemy.exc import SQLAlchemyError # Import specific SQLAlchemy exceptions

#from app.routers import budget # Import the budget router
from app.database import init_db # Import init_db function (optional)
from app.routers import budget, categories

# --- FastAPI App Initialization ---
app = FastAPI(
    title="Budget Buddy API",
    description="API for managing personal budget entries and summaries.",
    version="1.0.0",
)

# --- CORS Configuration ---
# Define allowed origins for your frontend application
origins = [
    "*",
]

app.add_middleware(
    CORSMiddleware,
    allow_origins=origins,
    allow_credentials=True,
    allow_methods=["GET", "POST", "PUT", "DELETE", "OPTIONS"], # Allow specific HTTP methods
    allow_headers=["*"], # Allow all headers, or specify specific ones
)

# --- Include Routers ---
# Register the budget router with the main FastAPI app under /api
app.include_router(budget.router, prefix="/api")
app.include_router(categories.router, prefix="/api")

# --- Global Exception Handler (Optional but Recommended) ---
@app.exception_handler(SQLAlchemyError)
async def sqlalchemy_exception_handler(request: Request, exc: SQLAlchemyError):
    """
    Handles SQLAlchemy errors globally, providing a consistent error response.
    """
    return JSONResponse(
        status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
        content={"message": "An internal database error occurred.", "detail": str(exc)},
    )

# --- Root Endpoint ---
@app.get("/", summary="Root endpoint", description="Welcomes to the Budget Buddy API.")
async def read_root():
    """
    Root endpoint of the API, returns a welcome message.
    """
    return {"message": "Welcome to the Budget Buddy API"}

# Health endpoint for Docker/K8s checks
@app.get("/api/health", summary="Health check", description="Returns OK if the service is healthy")
async def health():
    return {"status": "ok"}

# --- Startup Event (Optional) ---
@app.on_event("startup")
async def startup_event():
    """
    Event handler for application startup.
    Can be used to perform initial setup, like creating database tables.
    """
    print("Application startup: Initializing database...")
    # Uncomment the following line if you want SQLAlchemy to create tables on startup.
    # Be careful with this in production; migrations (e.g., Alembic) are preferred.
    init_db()
    print("Database initialization complete (or skipped).")

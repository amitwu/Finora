# --- Budget Items ---
from datetime import datetime, date
from typing import List, Optional, Any
from fastapi import APIRouter, Depends, HTTPException, Query, Response
from sqlalchemy.orm import Session
from app.database import get_db
from app import crud, schemas

router = APIRouter(prefix="/budget", tags=["Budget"])


# -------------------- BUDGET ITEMS CRUD --------------------

@router.get("/items", response_model=List[schemas.BudgetItem])
def get_budget_items(
    start_date: str = Query(..., description="Start date (YYYY-MM-DD)"),
    end_date: str = Query(..., description="End date (YYYY-MM-DD)"),
    db: Session = Depends(get_db),
):
    """Get all budget items between start_date and end_date inclusive."""
    try:
        start = datetime.strptime(start_date, "%Y-%m-%d").date()
        end = datetime.strptime(end_date, "%Y-%m-%d").date()
    except ValueError:
        raise HTTPException(status_code=400, detail="Dates must be YYYY-MM-DD")

    return crud.get_budget_items_by_date_range(db, start, end)


@router.post("/items", response_model=schemas.BudgetItem, status_code=201)
def create_budget_item(item: schemas.BudgetItemCreate, db: Session = Depends(get_db)):
    """Create a new budget item (supports arithmetic values)."""
    return crud.create_budget_item(db, item)


@router.put("/items/{item_id}", response_model=schemas.BudgetItem)
def put_budget_item(item_id: int, item: schemas.BudgetItemCreate, db: Session = Depends(get_db)):
    """Replace an entire budget item (PUT)."""
    updated = crud.update_budget_item(db, item_id, item)
    if not updated:
        raise HTTPException(status_code=404, detail="Item not found")
    return updated


@router.patch("/items/{item_id}", response_model=schemas.BudgetItem)
def patch_budget_item(item_id: int, item: schemas.BudgetItemUpdate, db: Session = Depends(get_db)):
    """Partially update a budget item (PATCH)."""
    updated = crud.patch_budget_item(db, item_id, item)
    if not updated:
        raise HTTPException(status_code=404, detail="Item not found")
    return updated


@router.delete("/items/{item_id}", status_code=204)
def delete_budget_item(item_id: int, db: Session = Depends(get_db)):
    """Delete a budget item."""
    success = crud.delete_budget_item(db, item_id)
    if not success:
        raise HTTPException(status_code=404, detail="Item not found")
    return Response(status_code=204)

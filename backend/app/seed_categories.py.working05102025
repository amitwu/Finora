# backend/app/seed_categories.py
from app.database import SessionLocal, engine
from app.models import CategoryDB

# Income and Expense categories
INCOME_CATEGORIES = [
  "משכורת 1",
  "משכורת 2",
  "הכנסה נוספת",
  "קצבה ביטוח לאומי",
  "הכנסה משכירות",
  "תמיכה",
  "בונוסים מתנות",
]

EXPENSE_CATEGORIES = {
  "בית שוטף": ["השכרת דירה /משכנתא", "ביטוח משכנתא", "ועד בית", "אחזקת בית", "ביטוחים חיים", "ביטוחים בריאות"],
  "ספקי שרות": ["חשמל", "ארנונה + מים", "גז", "יס / הוט", "בזק + בזק בינלאומי שיחות", "אורנג / פרטנר", "נקיון בית עוזרת"],
  "קניות": ["סופר פארם וכדומה", "ביגוד והנעלה", "מזון לבית", "קוסמטיקה", "קפה", "אלקטרוניקה ומיחשוב", "תספורת"],
  "רכב": ["תיקוני רכב", "ביטוחי רכב", "טסט", "הוצאות רכב", "דלק", "דוחות", "חניה", "כביש 6"],
  "פנאי ובילויים": ["חדר כושר \\ מנוי לקאנטרי", "אירועים ומתנות", "תרומות", "מסעדות בתי קפה בילויים בחוץ", "סיגריות אלכוהול"],
  "בנק": ["הלוואה מהבנק", "הלוואה חוץ בנקאית", "עמלות וריביות בנקים"],
  "שונות": ["שונות ובלתי צפויות", "רפואה פרטית", "חופשה טיול", "הוצאות בחופשה", "יהדות וחגים", "תשלומי עיריה", "דמי כרטיס אשראי", "מזומן", "דמי שימוש בחנויות וירטואליות"],
  "חופשות": ["חופשה טיול (כרטיסי טיסה + רכב + מלון)", "הוצאות קניות בחופשה", "ביטוח נסיעות לחול"],
}


def seed_categories():
    db = SessionLocal()

    try:
        # Clear existing data
        db.query(CategoryDB).delete()

        # Add income categories (no parent)
        for name in INCOME_CATEGORIES:
            db.add(CategoryDB(name=name, parent_id=None))

        # Add expense categories and subcategories
        for main_cat, subcats in EXPENSE_CATEGORIES.items():
            parent = CategoryDB(name=main_cat, parent_id=None)
            db.add(parent)
            db.flush()  # So we get parent.id

            for sub in subcats:
                db.add(CategoryDB(name=sub, parent_id=parent.id))

        db.commit()
        print("✅ Categories and subcategories seeded successfully!")

    except Exception as e:
        db.rollback()
        print("❌ Error while seeding:", e)
    finally:
        db.close()


if __name__ == "__main__":
    seed_categories()

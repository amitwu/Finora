version: '3.8'
services:
  db:
    image: postgres:14-alpine
    restart: always
    environment:
      POSTGRES_USER: user
      POSTGRES_PASSWORD: password
      POSTGRES_DB: mydatabase
    volumes:
      - pgdata:/var/lib/postgresql/data
  backend:
    build: ./backend
    restart: always
    environment:
      DATABASE_URL: "postgresql://user:password@db:5432/mydatabase"
    depends_on:
      - db
  frontend:
    build: ./frontend
    restart: always
    depends_on:
      - backend
  nginx:
    image: nginx:1.21
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf
      - ./nginx/certs:/etc/nginx/certs
    depends_on:
      - frontend
  # This service is for generating the SSL certificates.
  # Run this service once, then comment it out or remove it.
  # This service is for generating the SSL certificates.
  # Run this service once, then comment it out or remove it.
  certs:
    image: openssl:1.1.1-alpine
    container_name: cert_generator
    volumes:
      - ./nginx/certs:/certs
    command: req -x509 -nodes -days 756 -newkey rsa:2048 -keyout /certs/localhost.key -out /certs/localhost.crt -subj "/CN=localhost"

volumes:
  pgdata:



// Base URL for the backend API
// חשוב: שנה את ה-URL הזה לכתובת ה-Backend האמיתית שלך.
// אם אתה משתמש ב-ngrok, זה יהיה ה-URL ש-ngrok נותן לך (לדוגמה: 'https://abcdef12345.ngrok.io')
// אם אתה מריץ מקומית, זה יהיה 'http://127.0.0.1:8000'
const API_BASE_URL = '/api';

export const BudgetItemAPI = {
    // Fetches monthly summary data
    async getMonthlySummary({ month, year }) {
        try {
            const response = await fetch(`${API_BASE_URL}/budget/summary?month=${month}&year=${year}`);
            if (!response.ok) {
                const errorData = await response.json().catch(() => ({}));
                throw new Error(`Failed to fetch monthly summary: ${errorData.detail || response.statusText}`);
            }
            return await response.json();
        } catch (error) {
            console.error("Error fetching monthly summary:", error);
            throw error; // Re-throw to be handled by the component
        }
    },

    // Fetches all budget items for a given month and year
    async getBudgetItems({ month, year }) {
        try {
            const response = await fetch(`${API_BASE_URL}/budget/items?month=${month}&year=${year}`);
            if (!response.ok) {
                const errorData = await response.json().catch(() => ({}));
                throw new Error(`Failed to fetch budget items: ${errorData.detail || response.statusText}`);
            }
            return await response.json();
        } catch (error) {
            console.error("Error fetching budget items:", error);
            throw error; // Re-throw to be handled by the component
        }
    },

    // Creates or updates a budget item
    async createOrUpdateBudgetItem(itemData) {
        try {
            const response = await fetch(`${API_BASE_URL}/budget/items`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(itemData),
            });

            if (!response.ok) {
                const errorData = await response.json().catch(() => ({}));
                // FastAPI sends 'detail' for validation errors or custom messages
                throw new Error(`Failed to save budget item: ${errorData.detail || response.statusText}`);
            }
            return await response.json();
        } catch (error) {
            console.error("Error creating or updating budget item:", error);
            throw error; // Re-throw to be handled by the component
        }
    },

    // Function to call LLM for insights
    async getLlmInsights(prompt) {
        // Assuming your backend has an endpoint to proxy LLM requests
        // This is a placeholder for direct client-side LLM call if needed,
        // but typically you'd proxy through your backend for API key security.
        // For this project's existing structure, BudgetItemAPI.getLlmInsights is a direct LLM call.

        // The LLM API call directly from frontend as per previous solutions
        let chatHistory = [];
        chatHistory.push({ role: "user", parts: [{ text: prompt }] });
        const payload = { contents: chatHistory };
        // API key will be provided by Canvas runtime if empty
        const apiKey = "";
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`;

        const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (result.candidates && result.candidates.length > 0 &&
            result.candidates[0].content && result.candidates[0].content.parts &&
            result.candidates[0].content.parts.length > 0) {
            return result.candidates[0].content.parts[0].text;
        } else {
            console.error("Unexpected LLM response structure:", result);
            throw new Error("לא ניתן לקבל תובנות. מבנה תגובת LLM לא צפוי.");
        }
    }
};
